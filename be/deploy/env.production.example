# ============================================================================
# deploy/env.production.example — template env PRODUCTION cho VPS.
#
# Cách dùng (trên VPS):
#   cp deploy/env.production.example deploy/.env.production
#   nano deploy/.env.production                    # điền theo nhãn từng biến
#   bun run env:check --env-file deploy/.env.production   # GATE — phải ✅ mới up
#
# File thật `deploy/.env.production` đã được .gitignore — KHÔNG BAO GIỜ commit.
#
# NHÃN từng biến:
#   [TỰ SINH]      — sinh bằng openssl, lệnh ghi ngay cạnh biến.
#   [BẮT BUỘC THẬT] — phải là giá trị thật, sai là app chết hoặc auth/CORS hỏng.
#   [PLACEHOLDER-ĐƯỢC] — app vẫn boot với giá trị dummy có sẵn; chỉ feature
#                    tương ứng (email/upload) chưa chạy. Đổi khi bắt đầu dùng.
#   Giá trị còn dạng <...> = CHƯA ĐIỀN → `bun run env:check` sẽ FAIL (cố ý).
#
# TẬP BIẾN PROD-REQUIRED (thiếu 1 = boot chết = crash-loop từng gặp ở dự án trước):
#   DATABASE_URL, REDIS_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL,
#   TRUSTED_ORIGINS, RESEND_API_KEY, EMAIL_FROM
# (R2_* đã GỠ 2026-07-26 — xem B-ENV-1: không upload ảnh, nhận diện người bảo hộ
#  bằng nhãn text + địa chỉ ví. Xoá 4 dòng R2_* khỏi .env.production trên VPS.)
# (Nguồn: src/env.schema.ts — parity được enforce bởi `bun run check:env-parity`.)
# ============================================================================

# === Runtime ===
NODE_ENV=production
# PORT trong container — GIỮ 3000 (Dockerfile EXPOSE + healthcheck trỏ 3000).
PORT=3000
# [BẮT BUỘC THẬT] Port app bind ra HOST (127.0.0.1:APP_HOST_PORT → Caddy/nginx proxy).
# Mỗi project trên cùng VPS dùng 1 port TRỐNG khác nhau (GATE 1 runbook: scan trước).
APP_HOST_PORT=8000

# === Cluster + pool budget (docs/SCALE-RUNBOOK.md §bảng tier) ===
# WEB_INSTANCES = số core muốn dùng. Ràng buộc boot-guard:
#   (WEB_INSTANCES + 1) × DB_POOL_MAX ≤ 80% × PG_MAX_CONNECTIONS
# 4-core: WEB=4 POOL=12 · 8-core: WEB=8 POOL=8 · mặc định an toàn: WEB=2 POOL=20.
WEB_INSTANCES=2
# true CHỈ khi đứng sau Cloudflare thật (CF ghi đè header ở biên). Sau nginx
# thường thì để false — nginx đã ghi đè X-Forwarded-For bằng $remote_addr.
TRUST_CF_CONNECTING_IP=false
DB_POOL_MAX=20
PG_MAX_CONNECTIONS=100
# Core THẬT container được cấp (--cpus) — set để cảnh báo hash-budget chuẩn.
# CPU_CORES=4

# === Hash concurrency guard (README §hash guard) ===
# Trần box-wide = WEB_INSTANCES × HASH_MAX_CONCURRENT ≤ ~2×core.
# HASH_MAX_CONCURRENT=2
# HASH_ACQUIRE_TIMEOUT_MS=2000
# HASH_MAX_QUEUE=64

# === Database (Postgres chạy trong compose, service name `postgres`) ===
# [TỰ SINH] Password: openssl rand -hex 16
POSTGRES_USER=app
POSTGRES_PASSWORD=<TỰ_SINH_openssl_rand_-hex_16>
POSTGRES_DB=app
# Cần extension (pgvector/PostGIS)? Override image, KHÔNG sửa compose:
# POSTGRES_IMAGE=postgis/postgis:16-3.5
# Bump Dragonfly có chủ đích (verify tag bằng docker manifest inspect trước):
# DRAGONFLY_IMAGE=docker.dragonflydb.io/dragonflydb/dragonfly:v1.25.2

# === Backup (deploy/backup.sh — cron mẫu trong deploy/README.md) ===
# BACKUP_DIR=/var/backups/<proj>
# RETENTION_DAYS=7
# [BẮT BUỘC THẬT] App chạy bằng role RUNTIME `app_rt` (thành viên `app_runtime`,
# migration 0009): KHÔNG sở hữu bảng, KHÔNG DDL, KHÔNG UPDATE/DELETE/TRUNCATE trên
# audit_log. Đây là phòng tuyến THẬT của nhật ký append-only — trigger chỉ chặn tay
# nhầm, REVOKE mới chặn kẻ đã chiếm được connection. Nối bằng `app` (owner) là mất
# cả tầng này. Host = service name `postgres` (mạng nội bộ compose, DB không publish).
DATABASE_URL=postgres://app_rt:<MẬT_KHẨU_RUNTIME_RIÊNG>@postgres:5432/app
# ⚠️ DATABASE_URL_OWNER KHÔNG nằm trong file này — CÓ CHỦ ĐÍCH, đừng "sửa" bằng
# cách thêm lại. File này là `env_file:` của service `app` và `worker` trong
# deploy/docker-compose.prod.yml → mọi biến ở đây có mặt trong process app chạy
# 24/7. Owner URL ở đó = một lỗ RCE leo thẳng lên role sở hữu bảng, và tầng REVOKE
# trên `audit_log` (migration 0009) mất sạch tác dụng vì owner bypass mọi GRANT.
# Owner URL sống ở deploy/.env.migrate (mẫu: deploy/env.migrate.example) và được
# deploy.sh bơm qua `-e` vào container `run --rm` ephemeral của GATE migrate.

# === Cache & Queue (Dragonfly trong compose, service name `dragonfly`) ===
REDIS_URL=redis://dragonfly:6379

# === Auth (Better Auth) ===
# [TỰ SINH] openssl rand -base64 32   (≥ 32 ký tự)
BETTER_AUTH_SECRET=<TỰ_SINH_openssl_rand_-base64_32>
# [BẮT BUỘC THẬT] URL public của API (sau nginx + SSL).
BETTER_AUTH_URL=<https://api.tenmien.com>
# [BẮT BUỘC THẬT] Origin frontend được phép gọi (CSV, không khoảng trắng).
TRUSTED_ORIGINS=<https://app.tenmien.com>
# Prefix tên cookie session — mỗi dự án MỘT prefix riêng (default "app").
# COOKIE_PREFIX=app

# === Email (Resend) ===
# [PLACEHOLDER-ĐƯỢC] App boot OK với dummy — email chỉ fail khi thực sự gửi.
# Dùng thật: lấy key ở resend.com + verify domain, đổi 2 biến này.
RESEND_API_KEY=re_dummy_chua_dung_email
EMAIL_FROM=noreply@example.com
# SMTP_HOST/SMTP_PORT: CHỈ cho dev (Mailhog) — production để trống.
# SMTP_HOST=
# SMTP_PORT=

# === Storage (Cloudflare R2) ===
# [PLACEHOLDER-ĐƯỢC] App boot OK với dummy — upload chỉ fail khi thực sự dùng.

# === Observability (khuyến nghị BẬT ở production) ===
# SENTRY_DSN=

# === Webhook secrets (chỉ điền cho provider thực sự dùng) ===
# STRIPE_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=
# SEPAY_API_KEY=


# === Stellar / SEP-45 — MAINNET (fail-closed: 4 biến bắt buộc, hết default) ===
# Thiếu biến nào là env-check GATE đỏ, deploy.sh không up — đúng thiết kế.
# RPC provider MAINNET trả phí (BLOCKER: chọn provider rồi thay placeholder).
# HAI cách nạp key:
#  · Cách 1: provider nhúng key trong URL (https://rpc.xxx/<key>) → chỉ cần dòng này.
STELLAR_RPC_URL=<https://mainnet-rpc-provider-url>
#  · Cách 2: key rời → bỏ comment dòng dưới; proxy /rpc gửi `Authorization: Bearer <key>`.
#    Key KHÔNG BAO GIỜ đến FE/log/response — chỉ nằm trong env BE.
# STELLAR_RPC_API_KEY=<rpc-provider-api-key>
# Passphrase MAINNET — CHÍNH XÁC từng ký tự (kể cả khoảng trắng quanh ';').
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# Contract web_auth_verify MAINNET (deploy contracts/web-auth lên mainnet rồi điền).
# Thiếu → /api/sep45/* trả 503 (app vẫn sống).
# SEP45_WEB_AUTH_CONTRACT_ID=<C...-web-auth-mainnet>
# Secret key server ký challenge — key MAINNET RIÊNG (key testnet ≠ key mainnet,
# luật security.md). Account G tương ứng phải tồn tại trên mainnet (nạp XLM thật).
# SEP45_SIGNING_KEY=<S...-mainnet>
# 2 domain SEP-45 — BẮT BUỘC (hết default localhost):
SEP45_HOME_DOMAIN=familyhaven.mscilabs.com
SEP45_WEB_AUTH_DOMAIN=api.familyhaven.mscilabs.com
# SEP45_CHALLENGE_TTL_SECONDS=300
# SEP45_JWT_TTL_SECONDS=86400
# Indexer (PHA 4.2): CSV contract ID theo dõi. Trống = poll no-op.
# INDEXER_CONTRACT_IDS=

# === Tầng Stellar service (PHA 5.1) ===
# RPC dự phòng (optional). Ví PHÍ riêng — CHỈ XLM trả phí, TÁCH custody; trống → submit 503.
# STELLAR_RPC_FALLBACK_URL=
# FEE_WALLET_SECRET=
# Recovery registry testnet (spike cũ, PROJECT-BRIEF): CCPGVSLRFSUOGRFH3LAOWXSHJ2Y3QBFEA2ZTV4PWIINVGJWVDFA5GT3V
# CONTRACT_ID_RECOVERY=
# CONTRACT_ID_SAC_NATIVE=

# === Push (Firebase) — kênh push của dispatcher thông báo ===
# TRỐNG = push CHƯA cấu hình. Dispatcher sẽ đánh row `failed` với lý do
# PUSH_NOT_CONFIGURED + log ERROR — CỐ Ý ồn ào, không im lặng bỏ qua.
# Email mới là đường BẮT BUỘC cho sự kiện an ninh (push cần app còn cài + còn
# quyền + OS chưa kill; ví thừa kế thì người dùng có thể nhiều năm không mở app).
# Giá trị: nội dung file service-account JSON nén về MỘT dòng.
# FIREBASE_SERVICE_ACCOUNT_JSON=
