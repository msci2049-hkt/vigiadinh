# ============================================================================
# deploy/Caddyfile.example — reverse proxy ƯU TIÊN (runbook PHASE 10):
# Caddy tự xin + tự gia hạn TLS Let's Encrypt → ít thao tác tay hơn nginx+certbot.
# (VPS ĐÃ có nginx phục vụ app khác → dùng deploy/nginx.vhost.example thay,
#  đừng cài Caddy chồng lên — tranh port 80/443.)
#
# Cách dùng:
#   1. Thay <TEN_MIEN_API> và 8000 (= APP_HOST_PORT trong deploy/.env.production).
#   2. Nội dung này vào /etc/caddy/Caddyfile (thêm block, đừng xoá block app khác).
#   3. caddy validate --config /etc/caddy/Caddyfile && systemctl restart caddy
#   ⚠ Trước đó: firewall mở 80/443 + DNS trỏ IP VPS ở chế độ GREY (mây xám) —
#     Cloudflare mây cam khi xin cert = Let's Encrypt fail (runbook PHASE 11).
# ============================================================================

<TEN_MIEN_API> {
    reverse_proxy 127.0.0.1:8000 {
        # GHI ĐÈ IP client — chống spoof rate-limit (tương đương nginx
        # X-Real-IP $remote_addr; KHÔNG append kiểu $proxy_add_x_forwarded_for).
        header_up X-Real-IP {remote_host}
        # BẮT BUỘC (audit 2026-07-25 §6.3): Caddy mặc định APPEND IP client vào
        # X-Forwarded-For do client gửi, nên phần tử ĐẦU của XFF là giá trị kẻ gọi
        # tự đặt. App đọc X-Real-IP trước, nhưng ghi đè cả XFF để không còn header
        # nào mang dữ liệu giả — bỏ dòng này là mở lại đường vô hiệu rate-limit.
        header_up X-Forwarded-For {remote_host}
        # Tắt buffer cho SSE (/api/events) — tương đương proxy_buffering off.
        flush_interval -1
    }
}
