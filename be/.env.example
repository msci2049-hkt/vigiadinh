# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# Kiểm env đủ/đúng TRƯỚC khi chạy app: bun run env:check
# (Key ở đây được enforce khớp schema src/env.schema.ts — bun run check:env-parity.)

# === Runtime ===
NODE_ENV=development
PORT=3000

# === Auth (Better Auth) ===
# Sinh secret: openssl rand -base64 32  (tối thiểu 32 ký tự)
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_xxxxxxxxxxxxxxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
# Prefix tên cookie session — mỗi dự án MỘT prefix riêng (cookie không phân biệt
# port, 2 dự án cùng localhost sẽ đè cookie nhau). init-project tự set = slug.
# COOKIE_PREFIX=app
# Comma-separated, không có khoảng trắng. Biến này nuôi CẢ 3: CORS, CSRF và
# trustedOrigins của Better Auth → PHẢI chứa origin của FE (dev: 5173/5174),
# nếu không FE không đăng nhập được (cookie không bao giờ được set).
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# === Database (Postgres 16) ===
# DATABASE_URL = role RUNTIME (thành viên `app_runtime` — migration 0009): đọc/ghi
# nghiệp vụ bình thường, NHƯNG không DDL và không UPDATE/DELETE/TRUNCATE trên
# audit_log. Nối bằng role OWNER làm cả tầng REVOKE của 0009 thành trang trí —
# owner DROP TRIGGER rồi TRUNCATE nhật ký trong hai câu lệnh.
DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASS@HOST:5432/DBNAME
# Role OWNER (sở hữu bảng). CHỈ dùng cho `db:migrate` + `db:provision-runtime`.
# KHÔNG đặt biến này trong môi trường của process app.
DATABASE_URL_OWNER=postgresql://OWNER_USER:OWNER_PASS@HOST:5432/DBNAME
DB_POOL_MAX=20

# === Cluster + pool budget (chỉ chỉnh khi lên VPS — docs/SCALE-RUNBOOK.md) ===
# Boot-guard: (WEB_INSTANCES + 1) × DB_POOL_MAX ≤ 80% × PG_MAX_CONNECTIONS.
# Dev giữ default (WEB_INSTANCES=1). Prod: xem deploy/env.production.example.
# WEB_INSTANCES=1
# Chỉ đặt true khi app THỰC SỰ đứng sau Cloudflare. Bật bừa = rate-limit theo
# IP bị vô hiệu (client tự đặt CF-Connecting-IP mỗi request một giá trị).
# TRUST_CF_CONNECTING_IP=false
# PG_MAX_CONNECTIONS=100
# CPU_CORES=

# === Hash concurrency guard (chống login self-DoS — default chạy được) ===
# Trần box-wide = WEB_INSTANCES × HASH_MAX_CONCURRENT ≤ ~2×core (xem README).
# HASH_MAX_CONCURRENT=2
# HASH_ACQUIRE_TIMEOUT_MS=2000
# HASH_MAX_QUEUE=64

# === Cache & Queue (Dragonfly / Redis-compatible) ===
# Dragonfly khởi động với: --cluster_mode=emulated --lock_on_hashtags
# Default Redis/Dragonfly port. Nếu host đã có Redis service chiếm 6379,
# đổi sang port khác (vd: 6380, 3699) và sửa docker-compose.yml ports tương ứng.
REDIS_URL=redis://localhost:3699

# === Email (Resend) ===
RESEND_API_KEY=re_CHANGE_ME
# Domain phải verify trong Resend dashboard
EMAIL_FROM=noreply@yourdomain.com
# SMTP dev (Mailhog trong docker-compose — UI đọc mail: http://localhost:8025)
# SMTP_HOST=localhost
# SMTP_PORT=1025

# === Storage (Cloudflare R2) ===

# === Observability (Sentry, optional) ===
# Để trống tắt Sentry. Dev không cần.
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=  (dùng cho MCP server, không phải runtime)
# SENTRY_ORG=
# SENTRY_PROJECT=

# === Webhook secrets (optional) ===
# Chỉ điền cho provider mày dùng. verify.ts throw rõ ràng nếu chưa set
# === Stellar / SEP-45 (PHA 2.3) ===
# BẮT BUỘC từ mainnet migration (fail-closed, hết default testnet/localhost):
# thiếu 1 trong 4 biến STELLAR_RPC_URL / STELLAR_NETWORK_PASSPHRASE /
# SEP45_HOME_DOMAIN / SEP45_WEB_AUTH_DOMAIN là boot chết + env-check đỏ.
# Dev dùng giá trị testnet/localhost active dưới đây.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# API key RPC provider (optional — mainnet dùng provider trả phí). HAI cách nạp:
#  · Cách 1: provider nhúng key trong URL → chỉ cần STELLAR_RPC_URL, bỏ biến này.
#  · Cách 2: key rời → set biến này, proxy POST /rpc gửi `Authorization: Bearer <key>`.
# STELLAR_RPC_API_KEY=
# Contract web_auth_verify (contracts/web-auth) đã deploy. Chưa set → /api/sep45/* trả 503.
# SEP45_WEB_AUTH_CONTRACT_ID=
# Secret key server ký challenge (S...) — account G tương ứng phải được friendbot fund.
# SEP45_SIGNING_KEY=
# 2 domain SEP-45 — BẮT BUỘC (hết default localhost, fail-closed):
SEP45_HOME_DOMAIN=localhost:5173
SEP45_WEB_AUTH_DOMAIN=localhost:3000
# SEP45_CHALLENGE_TTL_SECONDS=300
# SEP45_JWT_TTL_SECONDS=86400
# Indexer (PHA 4.2): CSV contract ID theo dõi. Trống = poll no-op.
# INDEXER_CONTRACT_IDS=

# === Tầng Stellar service (PHA 5.1) ===
# RPC dự phòng (optional). Ví PHÍ riêng — CHỈ XLM trả phí, TÁCH custody; trống → submit 503.
# STELLAR_RPC_FALLBACK_URL=
# FEE_WALLET_SECRET=
# Recovery registry testnet (spike cũ, PROJECT-BRIEF): CCPGVSLRFSUOGRFH3LAOWXSHJ2Y3QBFEA2ZTV4PWIINVGJWVDFA5GT3V
# CONTRACT_ID_RECOVERY=
# CONTRACT_ID_SAC_NATIVE=
# Origin-verifier (cron ttl-keeper gia hạn instance+code — contract KHÔNG có extend_ttl):
# CONTRACT_ID_ORIGIN_VERIFIER=
# WASM hash smart-account (= FE VITE_ACCOUNT_WASM_HASH) — cron gia hạn CODE entry dùng chung:
# ACCOUNT_WASM_HASH=

# nhưng code gọi verifyX() — không silent return false.
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# GITHUB_WEBHOOK_SECRET=xxx
# SEPAY_API_KEY=xxx

# === MCP servers (optional, dev tooling) ===
# GITHUB_PERSONAL_ACCESS_TOKEN=  (cho MCP github)

# === Docker compose helpers ===
# Các biến này KHÔNG được env.ts validate — chỉ docker-compose.yml đọc để
# bootstrap container. App connect qua DATABASE_URL/REDIS_URL ở trên.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Tên compose project — prefix container/network/volume. Mỗi dự án MỘT tên riêng
# (init-project tự set = slug dự án) để nhiều dự án chạy song song không đè nhau.
# COMPOSE_PROJECT_NAME=  # default = "app" (xem docker-compose.yml dòng 1)
# Host port từng service (bind 127.0.0.1). Đổi để né port dự án khác đang chiếm.
# NHỚ: đổi DB_PORT/REDIS_PORT thì DATABASE_URL/REDIS_URL ở trên phải trỏ port mới.
# DB_PORT=5432
# REDIS_PORT=3699
# MAILHOG_SMTP_PORT=1025   # + sửa SMTP_PORT ở trên nếu bật
# MAILHOG_UI_PORT=8025
# API_PORT=3000            # chỉ dùng cho profile prod smoke local

# === Push (Firebase) — kênh push của dispatcher thông báo ===
# TRỐNG = push CHƯA cấu hình. Dispatcher sẽ đánh row `failed` với lý do
# PUSH_NOT_CONFIGURED + log ERROR — CỐ Ý ồn ào, không im lặng bỏ qua.
# Email mới là đường BẮT BUỘC cho sự kiện an ninh (push cần app còn cài + còn
# quyền + OS chưa kill; ví thừa kế thì người dùng có thể nhiều năm không mở app).
# Giá trị: nội dung file service-account JSON nén về MỘT dòng.
# FIREBASE_SERVICE_ACCOUNT_JSON=
