# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/
*.local

# env (never commit secrets) — keep the example
.env
.env.*
!.env.example

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# test / coverage
coverage/
.vitest/
playwright-report/
test-results/
blob-report/
**/playwright/.cache/

# turborepo / build caches (regenerated)
.turbo/
.cache/

# typescript incremental
*.tsbuildinfo

# TanStack Router generated route tree (regenerated by `tsr generate` / vite)
apps/*/src/app/routeTree.gen.ts
# TanStack Router/Start temp dir (regenerated)
.tanstack/

# Claude Code local (personal) settings — keep .claude/settings.json (shared) committed
.claude/settings.local.json

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
