# ============================================================================
# apps/web env — copy to `.env` and adjust. All vars MUST be prefixed VITE_
# and are validated by src/lib/env.ts (Zod). Never commit `.env`.
# ============================================================================

# Backend base URL (Bun + Hono + Better Auth). The Better Auth handler is
# expected at `${VITE_API_URL}/api/auth/*`, SSE at `${VITE_API_URL}/api/events`,
# health at `${VITE_API_URL}/health`. Dev default below.
VITE_API_URL=http://localhost:3000

# App display name — single source of truth. Drives the UI brand (src/config/site.ts
# → site.name) AND the browser tab <title> (Vite substitutes %VITE_APP_NAME% in
# index.html). Change this one value to rebrand the whole app.
VITE_APP_NAME=FamilyHaven

# Show TanStack Router/Query devtools in dev ("true" | "false").
VITE_ENABLE_DEVTOOLS=true

# Sentry (WP5 — chỉ prod): DSN của project Sentry tương ứng. Trống/bỏ = Sentry tắt.
# VITE_SENTRY_DSN=

# === Stellar / ví passkey — BẮT BUỘC (mainnet migration: hết default testnet) ===
# Thiếu 1 trong 2 biến dưới là src/lib/env.ts THROW lúc boot (fail-closed — chống
# bản build production im lặng trỏ testnet). Dev dùng testnet như dưới đây.
# Production (xem env.production.example): RPC đi qua proxy BE, KHÔNG gọi thẳng
# provider (key nằm ở BE):
#   VITE_STELLAR_RPC_URL=https://api.familyhaven.mscilabs.com/rpc
#   VITE_STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Giá trị TESTNET thật (public, không phải secret). Wasm hash = đợt 2026-07-29 (artifact release v0.1.0)
# (có vá B-SEC-1 — bản 78e7521f cũ ĐÃ BỎ, xem docs/DEPLOY.md). Origin-verifier
# dưới đây là bản DEV pin rpId=localhost, origins http://localhost:5173 + :4174
# (vite dev + preview e2e) — production dùng bản PROD-pin CBFCNHIO… qua GitHub
# vars / env.production.example, KHÔNG dùng bản DEV này.
VITE_ACCOUNT_WASM_HASH=c1b28d42da1b7b091307c9acb0d72b88f45cc29d404b4d3c30bca0250a9d565f
VITE_WEBAUTHN_VERIFIER_ADDRESS=CCNS6O5HBTF7XOOVCNF4XLTKORQ4JB4PKUKUA6CX2MW7OXOKGKKC2O4N
# rpId passkey — QUYẾT ĐỊNH KHÔNG ĐẢO LẠI ĐƯỢC. Authenticator băm rpId và nhúng
# vào credential NGAY LÚC TẠO; không API nào sửa được, không đường migrate. Đổi
# rpId = MỌI passkey chết = người dùng mất đường vào ví, chỉ còn guardian recovery.
#
# PRODUCTION (đã chốt 2026-07-26): familyhaven.mscilabs.com
#   KHÔNG dùng apex `mscilabs.com`: rpId là SCOPE — passkey điều khiển tiền sẽ gọi
#   được từ BẤT KỲ subdomain nào của apex, nên một subdomain khác dính XSS là gọi
#   được passkey ví. Hẹp lại thì TRÌNH DUYỆT tự từ chối, không chờ server kiểm.
#
# Build production mà để "localhost" thì src/lib/env.ts THROW (fail-closed) — Vite
# nướng env lúc BUILD, không chặn ở đó thì bản prod vẫn xanh và mọi passkey người
# dùng tạo ra đều gắn "localhost", chết vĩnh viễn trên domain thật.
# VITE_PASSKEY_RP_ID=localhost
# Registry khôi phục v2 (testnet, đợt 2026-07-27 — có vá B-SEC-1; bản CAFU4CZN…
# cũ ĐÃ BỎ). Ví được cắm registry NGAY trong tx deploy — thiếu biến này thì màn
# tạo ví CHẶN, vì ví deploy ra sẽ không khôi phục được và không ai biết cho tới
# đúng lúc cần (xem BUILD-LOG §P0 CONSTRUCTOR-REGISTRY).
VITE_RECOVERY_REGISTRY_ADDRESS=CDGBHEXSPNO4CJHYSSV4FZBN3C7XXQOPZPDATR65SH5QHRCDB2WL4JIR
# Cooldown (giây) sau khi khôi phục xoay khoá — ví chối mọi chữ ký trong cửa sổ này.
# VITE_RECOVERY_COOLDOWN_SECS=86400
# SAC của tài sản gốc (XLM) — FE PHẢI tự biết để đối chiếu entry TRƯỚC khi ký
# (lib/auth-entry-guard.ts). Thiếu biến này thì màn gửi tiền CHẶN ký, vì không
# có mốc nào để phát hiện entry bị tráo (audit 2026-07-25 P0-1).
# Phải KHỚP `CONTRACT_ID_SAC_NATIVE` của backend. Giá trị testnet dưới đây lấy
# bằng `stellar contract id asset --asset native --network testnet` (deterministic,
# AUDIT-2026-07-25 §8) — KHÔNG tái dùng cho mainnet (id khác network).
VITE_SAC_NATIVE=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Spending-limit policy contract — BẢN DEFAULT-CAPABLE v0.1.1 (verified 07-29,
# contracts/spending-limit-policy). Lô policy: ví MỚI cài policy này vào rule 0
# NGAY trong tx deploy (constructor); bản OZ CABZ6H4… cũ KHÔNG có đường install
# Default (params 2 trường) — dùng nó là deploy ví FAIL. Trống → ví ra đời không
# trần cứng, Cài đặt hiện nhắc bật sau. PHẢI khớp BE CONTRACT_ID_SPENDING_LIMIT_POLICY.
VITE_SPENDING_LIMIT_POLICY=CCIN4CP4HAFNDBSS7ZILGKBTUNC2TDAMFCLSI7E2TW44SJ7R7FTSFJZK
