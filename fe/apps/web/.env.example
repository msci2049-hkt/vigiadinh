# ============================================================================
# apps/web env — copy to `.env` and adjust. All vars MUST be prefixed VITE_
# and are validated by src/lib/env.ts (Zod). Never commit `.env`.
# ============================================================================

# Backend base URL (Bun + Hono + Better Auth). The Better Auth handler is
# expected at `${VITE_API_URL}/api/auth/*`, SSE at `${VITE_API_URL}/api/events`,
# health at `${VITE_API_URL}/health`. Dev default below.
VITE_API_URL=http://localhost:3000

# App display name — single source of truth. Drives the UI brand (src/config/site.ts
# → site.name) AND the browser tab <title> (Vite substitutes %VITE_APP_NAME% in
# index.html). Change this one value to rebrand the whole app.
VITE_APP_NAME=Mau Demo FE

# Show TanStack Router/Query devtools in dev ("true" | "false").
VITE_ENABLE_DEVTOOLS=true

# Sentry (WP5 — chỉ prod): DSN của project Sentry tương ứng. Trống/bỏ = Sentry tắt.
# VITE_SENTRY_DSN=

# === Stellar / ví passkey (PHA 2.3) — mặc định testnet ===
# VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Giá trị TESTNET DEV thật (public, không phải secret — deploy 2026-07-24, xem
# docs/evidence): wasm hash contracts/smart-account + origin-verifier bản DEV
# pin rpId=localhost, origins http://localhost:5173 + :4174 (vite dev + preview
# e2e). Production deploy verifier riêng theo domain thật rồi thay cả hai.
VITE_ACCOUNT_WASM_HASH=78e7521f391123c2dc119bdf2c3ecae1a4655fbf360e5c2a17fd12be028da170
VITE_WEBAUTHN_VERIFIER_ADDRESS=CCNS6O5HBTF7XOOVCNF4XLTKORQ4JB4PKUKUA6CX2MW7OXOKGKKC2O4N
# rpId passkey — QUYẾT ĐỊNH KHÔNG ĐẢO LẠI ĐƯỢC. Authenticator băm rpId và nhúng
# vào credential NGAY LÚC TẠO; không API nào sửa được, không đường migrate. Đổi
# rpId = MỌI passkey chết = người dùng mất đường vào ví, chỉ còn guardian recovery.
#
# PRODUCTION (đã chốt 2026-07-26): familyhaven.mscilabs.com
#   KHÔNG dùng apex `mscilabs.com`: rpId là SCOPE — passkey điều khiển tiền sẽ gọi
#   được từ BẤT KỲ subdomain nào của apex, nên một subdomain khác dính XSS là gọi
#   được passkey ví. Hẹp lại thì TRÌNH DUYỆT tự từ chối, không chờ server kiểm.
#
# Build production mà để "localhost" thì src/lib/env.ts THROW (fail-closed) — Vite
# nướng env lúc BUILD, không chặn ở đó thì bản prod vẫn xanh và mọi passkey người
# dùng tạo ra đều gắn "localhost", chết vĩnh viễn trên domain thật.
# VITE_PASSKEY_RP_ID=localhost
# Registry khôi phục v2 (testnet). Ví được cắm registry NGAY trong tx deploy —
# thiếu biến này thì màn tạo ví CHẶN, vì ví deploy ra sẽ không khôi phục được
# và không ai biết cho tới đúng lúc cần (xem BUILD-LOG §P0 CONSTRUCTOR-REGISTRY).
VITE_RECOVERY_REGISTRY_ADDRESS=CAFU4CZNPN5YWFV3QOCA4Y6FSJUB7IGI456MIGTQRJXA4DQLWUIHFMCO
# Cooldown (giây) sau khi khôi phục xoay khoá — ví chối mọi chữ ký trong cửa sổ này.
# VITE_RECOVERY_COOLDOWN_SECS=86400
# SAC của tài sản gốc (XLM) — FE PHẢI tự biết để đối chiếu entry TRƯỚC khi ký
# (lib/auth-entry-guard.ts). Thiếu biến này thì màn gửi tiền CHẶN ký, vì không
# có mốc nào để phát hiện entry bị tráo (audit 2026-07-25 P0-1).
# Phải KHỚP `CONTRACT_ID_SAC_NATIVE` của backend. Cả hai cùng trống = tính năng
# gửi tiền chưa cấu hình (BE trả 503, FE chặn ký) — trạng thái nhất quán, không
# phải lỗi. Đừng điền id đoán: sai SAC là chặn nhầm mọi giao dịch thật.
# VITE_SAC_NATIVE=
