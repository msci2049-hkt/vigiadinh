# ============================================================================
# env.production.example (KHÔNG chấm đầu — `.env.*` bị gitignore nuốt; cùng quy ước với be/deploy/README.md)
# → copy thành .env.production TRƯỚC KHI BUILD BẢN PROD.
# ⚠️ Vite nướng env vào bundle lúc BUILD, không đọc lúc chạy. Đổi bất kỳ giá trị
#    nào ở đây = PHẢI build lại. Deploy bundle cũ với env mới là không có tác dụng.
# ============================================================================

# API sau nginx + TLS. Xem BLOCKERS B-INFRA-1: domain này PHẢI để DNS-only trên
# Cloudflare (2 tầng subdomain → ngoài Universal SSL free → bật proxy là HTTP 000).
VITE_API_URL=https://api.familyhaven.mscilabs.com

# === rpId passkey — KHÔNG ĐẢO LẠI ĐƯỢC ===
# Chốt 2026-07-26. Authenticator băm rpId và nhúng vào credential NGAY LÚC TẠO:
# không API nào sửa được, không đường migrate. Đổi giá trị này sau khi có passkey
# đầu tiên = mọi passkey chết = người dùng mất đường vào ví, chỉ còn guardian recovery.
#
# KHÔNG dùng apex `mscilabs.com`: rpId là SCOPE. Apex nghĩa là passkey điều khiển
# tiền gọi được từ BẤT KỲ subdomain nào — một subdomain khác dính XSS là gọi được
# passkey ví. Scope hẹp thì TRÌNH DUYỆT tự từ chối, không phải chờ server kiểm.
VITE_PASSKEY_RP_ID=familyhaven.mscilabs.com

# === CHƯA ĐIỀN — build sẽ chặn hoặc tính năng sẽ khoá ===
# Origin-verifier bản DEV đang pin rpId=localhost + origin localhost:5173/4174.
# Production PHẢI deploy verifier riêng theo domain thật rồi thay CẢ HAI biến.
# VITE_ACCOUNT_WASM_HASH=
# VITE_WEBAUTHN_VERIFIER_ADDRESS=
# VITE_RECOVERY_REGISTRY_ADDRESS=
# VITE_SAC_NATIVE=
