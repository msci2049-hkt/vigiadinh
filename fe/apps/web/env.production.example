# CI dùng đúng bộ này qua GitHub vars (deploy-fe.yml gate D1).
# origin-verifier PROD pin rpId=familyhaven.mscilabs.com + 3 origin web/api/extension.
VITE_ACCOUNT_WASM_HASH=c1b28d42da1b7b091307c9acb0d72b88f45cc29d404b4d3c30bca0250a9d565f
