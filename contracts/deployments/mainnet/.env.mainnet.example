# Copy to .env.mainnet.local, replace every placeholder, and chmod 600.
# Never put a secret key here. MAINNET_SOURCE_ACCOUNT is a Stellar CLI identity alias.
MAINNET_RPC_URL='https://rpc-provider.example/<api-key-or-path>'
MAINNET_SOURCE_ACCOUNT='family-mainnet-deployer'
MAINNET_RP_ID='familyhaven.mscilabs.com'
MAINNET_ALLOWED_ORIGINS_JSON='["https://familyhaven.mscilabs.com","https://api.familyhaven.mscilabs.com","chrome-extension://aakakeieeijeflbnblolnlhmooibddmc"]'
MAINNET_PRODUCTION_EXTENSION_ID='aakakeieeijeflbnblolnlhmooibddmc'
MAINNET_NETWORK_PASSPHRASE='Public Global Stellar Network ; September 2015'
MAINNET_NETWORK_NAME='mainnet-core'

# Must equal the preparation commit at deployment time.
MAINNET_EXPECTED_GIT_SHA='<full-preparation-commit-sha>'

# Hard fee gates. The total covers all required uploads and global deployments.
MAINNET_MAX_TOTAL_FEE_XLM='25'
MAINNET_MIN_SOURCE_BALANCE_XLM='30'
MAINNET_INCLUSION_FEE_STROOPS='100'

# Exact opt-in. Any other value runs preflight only.
EXECUTE_MAINNET_DEPLOY='NO'
